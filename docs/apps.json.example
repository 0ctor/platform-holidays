{
  "repos": {
    "0ctor/platform-holidays": {
      "branch": "main",
      "app": "platform-holidays",
      "kind": "single",
      "script": "/home/ubuntu/octor/scripts/deploy/app.sh",
      "images": {
        "web": "ghcr.io/0ctor/platform-holidays"
      },
      "build": {
        "enabled": true,
        "dockerfile": "Dockerfile",
        "context": "."
      },
      "health": {
        "container": "octor-platform-holidays",
        "url": "http://127.0.0.1:15216/health/ready",
        "public": "https://holidays.octor.com.br/health/ready"
      }
    }
  }
}
