APP_ENV=development
OCTOR_SERVICE_NAME=template-api-rust
BIND_ADDRESS=0.0.0.0:8080

# User de aplicação — nunca root
DATABASE_URL=mysql://app_user:change-me@127.0.0.1:3306/template_db
DATABASE_MAX_CONNECTIONS=10

AUTH_INTROSPECT_URL=https://auth.octor.com.br/v1/auth/introspect
AUTH_TIMEOUT_MS=2000
ALLOWED_CORS_ORIGINS=http://localhost:3000,https://foo.octor.com.br

# Loki (opcional em local; obrigatório em produção)
LOKI_PUSH_URL=
LOKI_PUSH_USER=
LOKI_PUSH_PASSWORD=
LOKI_JOB=template-api-rust

RUST_LOG=template_api_rust=info,actix_web=info
